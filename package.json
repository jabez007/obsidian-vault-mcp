{
  "name": "obsidian-vault-mcp",
  "version": "2.0.0",
  "description": "Obsidian vault MCP server with local RAG capabilities for Codex and compatible MCP hosts",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=cjs --external:@lancedb/lancedb --external:onnxruntime-node --external:sharp --banner:js=\"var import_meta = { url: 'file://' + __filename };\" --define:import.meta=import_meta",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "codex",
    "plugin",
    "obsidian",
    "rag",
    "lancedb",
    "ai",
    "llm",
    "vector-search",
    "mcp"
  ],
  "author": "jabez007",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jabez007/obsidian-vault-mcp.git"
  },
  "homepage": "https://github.com/jabez007/obsidian-vault-mcp",
  "bugs": {
    "url": "https://github.com/jabez007/obsidian-vault-mcp/issues"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "moment": "^2.30.1",
    "onnxruntime-node": "1.14.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/glob": "^8.1.0",
    "@types/md5": "^2.3.6",
    "@types/moment": "^2.11.29",
    "@types/node": "^25.2.0",
    "@xenova/transformers": "^2.17.2",
    "esbuild": "^0.28.0",
    "glob": "^13.0.1",
    "gray-matter": "^4.0.3",
    "md5": "^2.3.0",
    "typescript": "^6.0.2",
    "vitest": "^3.2.1",
    "@eslint/js": "^9.26.0",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.31.0"
  }
}
